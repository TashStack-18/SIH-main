# 🇮🇳 Bharat Safe Yatra — Environment Configuration
# Phase 9B: Real Provider & Live Data Integration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ============================================================
# NEXT.JS PUBLIC CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# 1. MAPS & GIS PROVIDERS
# Mapbox public token — get from https://account.mapbox.com/
# Required for: Client-side Mapbox GL JS v3, 3D terrain rendering
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_real_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=sk.your_real_mapbox_secret_token_here

# Google Maps API Key — get from https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================
# 2. WEATHER & MARINE METEOROLOGY
# ============================================================
# OpenWeather API Key — get from https://home.openweathermap.org/api_keys
# Primary provider for: Realtime Weather, 5-Day Forecast, Air Quality Index (AQI)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# WeatherAPI.com Key — get from https://www.weatherapi.com/
# Specialized provider for: Marine wave height & swell telemetry for island UTs
WEATHERAPI_KEY=your_weatherapi_key_here

# ============================================================
# 3. FLIGHTS & ACCOMMODATION (GDS)
# ============================================================
# Amadeus for Developers — get from https://developers.amadeus.com/
# Primary provider for: Flight Offers Search v2 & Hotel Search v3
AMADEUS_CLIENT_ID=your_amadeus_api_key_here
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_here

# ============================================================
# 4. CURRENCY & FOREX
# ============================================================
# ExchangeRate-API — get from https://www.exchangerate-api.com/
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# ============================================================
# 5. PAYMENTS & TRANSACTIONS
# ============================================================
# Razorpay India — get from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ============================================================
# 6. SERVER-SIDE SECURITY & AI ENGINE
# ============================================================
# JWT signing secret — MUST be changed before production deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-64-char-random-hex-secret-before-production

# OpenAI API key — get from https://platform.openai.com/api-keys
# Required for: Yatra AI Travel Studio, Grounded Semantic RAG
OPENAI_API_KEY=sk-your_real_openai_api_key_here

# ============================================================
# 7. DATABASE & REDIS
# ============================================================
# PostgreSQL 16 with PostGIS and pgvector extensions
DATABASE_URL=postgresql://bharat_safe_yatra:password@localhost:5432/bharat_safe_yatra

# Redis Cache & Rate Limiting Engine
REDIS_URL=redis://localhost:6379
